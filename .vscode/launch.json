{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "cwd": "${workspaceFolder}/backend",
      "args": [
        "app.main:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8765"
      ],
      "envFile": "${workspaceFolder}/backend/.env",
      "justMyCode": false,
      "jinja": true
    }
  ]
}
